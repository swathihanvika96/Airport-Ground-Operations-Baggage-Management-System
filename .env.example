# ---------- App ----------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

# ---------- MySQL (PyMySQL driver) ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=Hanvika@061120
MYSQL_DB=airport_ground_ops

MYSQL_ROOT_PASSWORD=rootpassword

AUTO_CREATE_TABLES=false

# ---------- JWT ----------
# python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# true = new accounts inactive until an admin activates them
REGISTRATION_REQUIRES_APPROVAL=false
# dev only (no email service) - set false in production
EXPOSE_RESET_TOKEN=true

# ---------- First super admin ----------
FIRST_SUPERUSER_EMAIL=admin@airportops.com
FIRST_SUPERUSER_PASSWORD=Admin@12345
FIRST_SUPERUSER_NAME=Super Admin

# ---------- OAuth2 social sign-up / login (Google) - optional ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
OAUTH_DEFAULT_ROLE=CHECKIN_AGENT

# ---------- Optional ----------
# e.g. redis://localhost:6379/0
REDIS_URL=
REPORTS_DIR=generated_reports
# docker: load synthetic demo data on start
SEED_DEMO_DATA=true
